---
import { getSinglePage } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import { humanize, plainify, slugify } from "@/lib/utils/textConverter";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { BiCalendarEdit, BiCategoryAlt } from "react-icons/bi";

type Props = {
  posts: CollectionEntry<"posts">[];
  className?: string;
  fluid?: boolean;
};

const authors = await getSinglePage("authors");
const { className, posts, fluid } = Astro.props;
---

<div
  class={`row gy-5 gx-4 ${className} ${posts.length == 1 ? "justify-center" : ""} `}
>
  {
    posts.map((post, i: number) => (
      <div class={i === 0 && fluid != false ? "col-12" : "col-12 sm:col-6"}>
        {post.data.image && (
          <a
            href={`/${post.id}`}
            class="rounded-lg block hover:text-primary overflow-hidden group"
          >
            <Image
              class="w-full rounded-lg"
              src={post.data.image}
              alt={post.data.title}
              width={i === 0 ? 925 : 445}
              height={i === 0 ? 475 : 230}
              fetchpriority="high"
              loading="eager"
              decoding="sync"
              
            />
          </a>
        )}
        <ul class="mt-6 mb-4 flex flex-wrap items-center text-text">
          <li class="mr-5">
            {authors
              .filter((author) =>
                post.data.authors
                  .map((author) => slugify(author))
                  .includes(slugify(author.data.title))
              )
              .map((author) => (
                <a
                  href={`/autor/${slugify(author.data.title)}`}
                  class="flex items-center hover:text-primary font-medium"
                >
                  {author.data.image && (
                    <Image
                      src={author.data.image}
                      alt={author.data.title}
                      height={50}
                      width={50}
                      class="mr-2 h-6 w-6 rounded-full"
                    />
                  )}
                  <span>{author.data.title}</span>
                </a>
              ))}
          </li>
          <li class="mr-5 flex items-center flex-wrap font-medium">
            <BiCalendarEdit className="mr-1 h-5 w-5 text-gray-600" />
            {dateFormat(post.data.date!)}
          </li>
          <li class="mr-5 flex items-center flex-wrap">
            <BiCategoryAlt className="mr-1 h-[18px] w-[18px] text-gray-600" />

            <ul>
              {post.data.categories.map((category, i: number) => (
                <li class="inline-block">
                  <a
                    href={`/categorias/${slugify(category)}`}
                    class="mr-2 hover:text-primary font-medium"
                  >
                    {humanize(category)}
                    {i !== post.data.categories.length - 1 && ","}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        </ul>
        <h3 class="mb-4">
          <a
            href={`/${post.id}`}
            class="block hover:text-primary transition duration-300"
          >
            {post.data.title}
          </a>
        </h3>
        <p class="text-text line-clamp-2">{plainify(post.body ?? "")}</p>
      </div>
    ))
  }
  <div class="mt-16 pt-8 border-t border-border">
        <h1 class="h5 mb-4">Descargar juegos gratis</h1>
        <p class="mb-4">
  <div id="seo-content" class="relative max-h-[300px] overflow-hidden transition-all duration-500 ease-in-out">
    <p class="mb-4">
      ¡Hola, jugador! ¡Sumérgete en el universo de tus juegos de PC favoritos en telechargerdesjeux.com!
      Nuestro moderno portal es un auténtico paraíso para los apasionados del entretenimiento digital.
      Cada jugador de PC encontrará aquí lo que busca. ¡Con nosotros puedes descargar juegos para PC gratis!
    </p>

    <p class="mb-6">
      En nuestra web encontrarás tanto clásicos de culto como novedades.
      Desde los juegos de tu infancia hasta los últimos éxitos. Esperamos que nuestro detallado árbol de categorías
      te facilite la navegación y la búsqueda de auténticas joyas. ¡Jugar en PC nunca ha sido tan sencillo y accesible!
    </p>

    <h3 class="h5 mt-8 mb-4">Las categorías de juegos de PC más populares</h3>

    <div class="space-y-4 mb-8">
      <div>
        <h3 class="h6 font-bold mb-4">Juegos de acción</h3>
        <p>
          El grupo más amplio de títulos para PC, que además ofrece un modelo de jugabilidad realmente variado.
          ¡Lo que cuenta es la acción! En cuanto a las mecánicas, son muy variadas. Aquí encontrarás los juegos más importantes,
          los mayores presupuestos y el mayor espectáculo. A esto se suman una trama narrativa rica y un aspecto cinematográfico.
          ¡Los juegos de acción son, sencillamente, juegos divertidos!
        </p>
      </div>

      <div>
        <h3 class="h6 font-bold mb-1">Juegos de estrategia</h3>
        <p>
          Prepara tus tácticas, comandante. En esta subcategoría, tomarás el mando de tus tropas.
          Ya sea en modo por turnos, en RTS o en modo mixto. Los juegos de estrategia para PC ofrecen algo realmente único.
          En ellos puedes conquistar, colonizar, luchar, desarrollar, construir, etc. Cada estrategia ofrece algo diferente,
          pero todas son realmente cautivadoras. ¡Cuidado!
        </p>
      </div>

      <div>
        <h3 class="h6 font-bold mb-1">Juegos FPS</h3>
        <p>
          Juegos de disparos virtuales. Campos de batalla en los que te pones en la piel de un soldado. Da igual si se trata de juegos de disparos
          en línea o cooperativos. En este género, tendrás que disparar mucho a diversos adversarios. Aprovecha tus habilidades
          en línea, colabora y entrena para reaccionar con rapidez, y quizá salgas con vida.
        </p>
      </div>

      <div>
        <h3 class="h6 font-bold mb-1">Juegos de simulación</h3>
        <p>
          ¡Las simulaciones constituyen un ámbito enorme! Son juegos que combinan relajación, gestión y entretenimiento.
          Hoy en día existe una gran variedad de simuladores y cada uno tiene sus seguidores. Cada sistema es único.
          Gestionar una granja, un taller o tu propio equipo deportivo. ¡Aquí, todo me parece a la vez muy realista y sencillamente posible!
        </p>
      </div>

      <div>
        <h3 class="h6 font-bold mb-1">Juegos de rol</h3>
        <p>
          Juegos de rol en su forma más pura. Crea tu propio héroe, elige su clase, aventúrate en las mazmorras
          y gana experiencia. Estos juegos te permiten hacerlo todo. Utiliza magia misteriosa y el mejor equipamiento.
          Los elementos de desarrollo del personaje están presentes en muchos juegos, pero solo en los RPG alcanzan tal nivel.
          Cada mundo seduce por su magnitud y hace posible lo imposible. Descubre los RPG fantásticos en los que te enfrentas a terribles monstruos.
          Prueba los RPG de acción que hacen hincapié en la trama y en una jugabilidad agradable. ¿O quizá prefieres algo histórico?
          ¡También hay títulos de este género! La diversión no tiene límites: ¡te metes en la piel de un personaje y te lanzas a la aventura en un mundo abierto!
          ¿Qué podría salir mal?
        </p>
      </div>
    </div>
<h3 class="h5 mt-8 mb-4">Los videojuegos para PC más populares del mercado</h3>

    <p class="mb-4">
      Es un tema muy amplio. ¿Cuál es el videojuego más popular? Ni siquiera vamos a intentar responder a esa pregunta.
      Al fin y al cabo, cada uno tiene sus preferencias. No obstante, os presentaremos algunos de los títulos que mejor se venden en nuestra tienda.
      ¡Confiamos en nuestros clientes! Sería un pecado no mencionar The Witcher o Diablo, pero aún no alcanzan ese nivel.
      En nuestra tienda, son otras producciones en las que quizá no habrías pensado las que reinan. Se trata, por ejemplo, de Cyberpunk 2077, <a href="/resident-evil-requiem-descargar-gratis" class="text-primary underline">Resident Evil Requiem</a> o Hogwarts Legacy. Como de costumbre, <a href="/gta5-descargar-pc" class="text-primary underline">GTA 5</a> y <a href="/red-dead-redemption-2-descargar-gratis" class="text-primary underline">Red Dead Redemption 2</a> se mantienen a la cabeza: ¡Rockstar nunca decepciona!
    </p>

    <p class="mb-4">
      En los últimos años, los juegos con un nivel de dificultad muy alto están viviendo un auténtico renacimiento.
      En lo más alto se encuentran, por supuesto, la serie Dark Souls y <a href="/elden-ring-descargar-gratis-pc" class="text-primary underline">Elden Ring</a>. Los éxitos de ventas de From Software han definido el género «soulslike» y se venden como pan caliente. <a href="/crimson-desert-gratis-descargar" class="text-primary underline">Crimson Desert</a> es también uno de los nuevos juegos más interesantes.
    </p>

    <p class="mb-4">
      Cuando hablamos del mercado polaco, es imposible pasar por alto la serie <a href="/farming-simulator-25-descargar-gratis" class="text-primary underline">Farming Simulator</a>. Millones de jugadores de todo el mundo no pueden equivocarse. Si te ríes, es que realmente no sabes de qué se trata.
      Maquinaria con licencia, tu propia granja, tu personaje, elementos de microgestión y mucho más.
      Este éxito se debe a multitud de factores. ¡No nos sorprende en absoluto!
    </p>

    <p class="mb-4">
      Matar monstruos siempre mola, y esta vez es imposible no mencionar Monster Hunter.
      Las arenas con jefes gigantescos son solo la punta del iceberg. ¿Quién no querría convertirse en cazador de bestias gigantes? ¡¿Quién, por favor?!
    </p>

    <p class="mb-6">
      Los juegos deportivos también son un placer para el gran público. Dejaremos de lado <a href="/ea-sports-fc-26-descargar-gratis" class="text-primary underline">EA Sports FC</a> y esta vez nos centraremos en el baloncesto. NBA 2K es una serie fenomenal, llena de competición,
      progresión y misiones especiales. Cada canasta es una alegría, y los gráficos son impresionantes.
      ¡Un paraíso para los aficionados al baloncesto, lo recomendamos!
    </p>

    <h3 class="h5 mt-8 mb-4">¡Que te diviertas!</h3>

    <p class="mb-4">
      Ni siquiera hemos mencionado el 1 % de todas las producciones que ofrecemos. Es lógico que la mayoría sigan siendo un misterio.
      Están ocultos entre los secretos de nuestra web. ¡Te animamos a que los descubras! Tenemos juegos para todas las ocasiones,
      para jugadores de todas las edades. Los universos de Star Wars o El Señor de los Anillos no nos son ajenos.
      Damos soporte a todas las plataformas de distribución digital. Colaboramos con grandes empresas y desarrolladores independientes.
      ¡Nos encantan los juegos!
    </p>

<p class="mb-4">
      Los videojuegos para PC son nuestra pasión: confía en nosotros y embárcate en un viaje de diversión digital.
      Síguenos en las redes sociales y descarga videojuegos gratis desde una fuente fiable. ¡Bienvenido!
    </p>

    <div id="seo-overlay" class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-body to-transparent pointer-events-none"></div>
  </div>

  <div class="text-center mt-4">
    <button id="seo-toggle-btn" class="btn btn-outline-primary text-sm px-6 py-2">
      Leer más
    </button>
  </div>

<script>
  const content = document.getElementById('seo-content');
  const overlay = document.getElementById('seo-overlay');
  const btn = document.getElementById('seo-toggle-btn');

  if (content && overlay && btn) {
    btn.addEventListener('click', () => {
      const isExpanded = content.classList.contains('max-h-full');

      if (isExpanded) {
        // Zwijanie
        content.classList.remove('max-h-full');
        content.classList.add('max-h-[300px]');
        overlay.classList.remove('hidden');
        btn.textContent = 'Leer más';
      } else {
        // Rozwijanie
        content.classList.remove('max-h-[300px]');
        content.classList.add('max-h-full');
        overlay.classList.add('hidden');
        btn.textContent = 'Reducir';
      }
    });
  }
</script>
        </p>
      </div>
</div>
